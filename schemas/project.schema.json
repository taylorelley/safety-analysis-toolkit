{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "assurance": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "standard": {
                  "const": "DO-178C"
                },
                "level": {
                  "enum": [
                    "A",
                    "B",
                    "C",
                    "D",
                    "E"
                  ]
                }
              },
              "required": [
                "standard",
                "level"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "standard": {
                  "const": "DO-278A"
                },
                "level": {
                  "enum": [
                    "AL1",
                    "AL2",
                    "AL3",
                    "AL4",
                    "AL5",
                    "AL6"
                  ]
                }
              },
              "required": [
                "standard",
                "level"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "coding": {
      "type": "object",
      "properties": {
        "c": {
          "anyOf": [
            {
              "const": "MISRA-C:2012"
            },
            {
              "type": "null"
            }
          ]
        },
        "cpp": {
          "anyOf": [
            {
              "const": "MISRA-CPP:2023"
            },
            {
              "type": "null"
            }
          ]
        },
        "registries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
          }
        },
        "deviations": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recategorization": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "properties": {
        "compile_commands": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
        },
        "variants": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
        },
        "reviews": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "tools": {
      "type": "object",
      "properties": {
        "clang": {
          "type": "boolean"
        },
        "frama_c": {
          "type": "boolean"
        },
        "esbmc": {
          "type": "boolean"
        },
        "require_filesystem_isolation": {
          "type": "boolean"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 128,
          "maximum": 65536
        },
        "jobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "clang_module": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^/"
            },
            {
              "type": "null"
            }
          ]
        },
        "mcp_operation_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 86400
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
        }
      }
    }
  },
  "required": [
    "version",
    "project"
  ],
  "additionalProperties": false
}
