{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^RUN-[0-9-]+$"
    },
    "operation": {
      "enum": [
        "scan",
        "doctor",
        "trace",
        "prove",
        "coverage"
      ]
    },
    "project": {
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "findings",
        "incomplete"
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "completeness": {
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "analyzed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0
        },
        "build_variants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "total",
        "analyzed",
        "failed",
        "excluded",
        "unsupported",
        "build_variants"
      ],
      "additionalProperties": false
    },
    "started_unix_ms": {
      "type": "integer",
      "minimum": 0
    },
    "completed_unix_ms": {
      "type": "integer",
      "minimum": 0
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "executions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "executable_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "restrictions": {
            "type": "string"
          },
          "executable": {
            "type": "string"
          },
          "arguments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "environment": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "exit_code": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "failure": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "stdout": {
            "type": "string"
          },
          "stderr": {
            "type": "string"
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "executable_sha256",
          "restrictions",
          "executable",
          "arguments",
          "cwd",
          "environment",
          "exit_code",
          "failure",
          "duration_ms",
          "stdout",
          "stderr",
          "timeout_seconds"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          },
          "rule_id": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "severity": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "build_variant": {
            "type": "string"
          },
          "outcome": {
            "const": "DIAGNOSTIC"
          },
          "native_references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "tool",
          "rule_id",
          "file",
          "line",
          "column",
          "severity",
          "message",
          "build_variant",
          "outcome",
          "native_references"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "git": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "PROVEN",
              "VIOLATED",
              "UNKNOWN",
              "NOT_CHECKED",
              "FAILED"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unwind_bound": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "completeness_established": {
            "type": "boolean"
          },
          "native_references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "description",
          "outcome",
          "scope",
          "assumptions",
          "unwind_bound",
          "completeness_established",
          "native_references"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "id",
    "operation",
    "project",
    "status",
    "complete",
    "completeness",
    "started_unix_ms",
    "completed_unix_ms",
    "inputs",
    "executions",
    "findings",
    "limitations",
    "git"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "incomplete"
          }
        }
      },
      "then": {
        "properties": {
          "complete": {
            "const": false
          }
        }
      }
    }
  ]
}
