{
  "version": 1,
  "trace": {
    "manifest": "trace.yaml"
  },
  "project": {
    "name": "mixed-safety-demo"
  },
  "assurance": null,
  "coding": {
    "c": "MISRA-C:2012",
    "cpp": "MISRA-CPP:2023"
  },
  "build": {
    "variants": {},
    "compile_commands": "build/compile_commands.json"
  },
  "tools": {
    "clang_module": "/workspace/safety/build/clang/SafetyMisra.so",
    "require_filesystem_isolation": false,
    "clang": true,
    "frama_c": true,
    "esbmc": true,
    "timeout_seconds": 60,
    "memory_mb": 2048,
    "allowlist": [
      "/workspace/safety/build/clang/SafetyMisra.so",
      "/workspace/scratch/llvm/usr/lib/llvm-19/bin/clang-tidy",
      "/workspace/scratch/llvm/usr/lib/llvm-19/bin/clang",
      "/workspace/safety/build/clang/safety-source-index",
      "/workspace/scratch/llvm/usr/lib/llvm-19/bin/llvm-cov",
      "/workspace/scratch/llvm/usr/lib/llvm-19/bin/llvm-profdata",
      "/workspace/scratch/esbmc/release/bin/esbmc",
      "/usr/local/bin/git"
    ]
  },
  "evidence": {
    "directory": ".safety/runs"
  }
}